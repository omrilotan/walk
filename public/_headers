# Security headers for every static page and file (Workers static assets).
# The Worker's own pages (sign-in for assistants, consent) set theirs in src/util.ts.
/*
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: bluetooth=(self), camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
